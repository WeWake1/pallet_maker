# /etc/caddy/Caddyfile
#
# Caddy does TLS (a certificate from Let's Encrypt, renewed by itself), sends
# HTTP to HTTPS, and hands everything to the server on the loopback.
#
# Nothing stands at the door here: the server asks who is signing in, and every
# route that touches a design is behind that. Caddy's own password prompt would
# only be a second one to get through, and would break the invitation links.

pallets.example.com {
	encode zstd gzip

	# The two import routes take a whole library in one body.
	request_body {
		max_size 70MB
	}

	reverse_proxy 127.0.0.1:5179 {
		transport http {
			# A sheet on a busy moment waits its turn to print.
			read_timeout 90s
		}
	}
}
