# /etc/pallet-spec/restic.env — the off-site copy. chmod 600 root:root is not
# enough: the backup runs as the pallet user, so chmod 640 root:pallet.

# An Azure storage account with one container for these backups.
RESTIC_REPOSITORY=azure:pallet-spec-backups:/
AZURE_ACCOUNT_NAME=yourstorageaccount
AZURE_ACCOUNT_KEY=...

# Encrypts every backup. Lose this and the backups are noise: keep a copy
# somewhere that is not this machine.
RESTIC_PASSWORD=...

# Optional: a healthchecks.io (or similar) URL to ping when a backup succeeds,
# so silence is noticed.
HEALTHCHECK_URL=
