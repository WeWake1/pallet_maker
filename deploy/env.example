# /etc/pallet-spec/env — read by the systemd units. Copy, edit, chmod 640 root:pallet.

# Everything the server keeps: the registry of companies and people, and a
# folder of designs per company. Put it on the data disk, not the OS disk.
PALLET_DATA_ROOT=/var/lib/pallet-spec

# Signs the cookie that keeps people signed in. Make one with:
#   openssl rand -hex 32
# Changing it signs everybody out, which is also how to sign everybody out.
SESSION_SECRET=

# Where this server answers. The links in invitations point here, and cookies
# are only marked Secure when this is https — so get it right before inviting
# anybody.
PALLET_PUBLIC_URL=https://pallets.example.com

# Email, for invitations and new-password links. Leave PALLET_SMTP_HOST unset
# and the links are only shown on screen, to be sent by hand.
#
# Any SMTP service works. Use one that sends for your own domain and set up
# its SPF and DKIM records in DNS first, or the mail lands in spam. Port 587 is
# STARTTLS, 465 is TLS from the start; Azure blocks outbound port 25, so do not
# use that. Check it from the Companies screen: "Send me a test email".
# Keep the sender in double quotes: it has spaces, and the pallet-tenant
# command in the README reads this file through xargs, which splits on them.
#PALLET_SMTP_HOST=smtp.example.com
#PALLET_SMTP_PORT=587
#PALLET_SMTP_USER=
#PALLET_SMTP_PASS=
#PALLET_MAIL_FROM="Pallet Spec <no-reply@example.com>"

# The Chromium that prints the sheets. Debian's package puts it here.
PALLET_BROWSER=/usr/bin/chromium

# How many sheets print at once. Each one is about a quarter of a gigabyte of
# Chromium while it runs. 2 on a 4 GiB machine; 1 on a 1 GiB one (see the
# README, section 1a).
PALLET_PRINT_CONCURRENCY=2

# Loopback only: Caddy is the only thing that talks to it.
HOST=127.0.0.1
PORT=5179

# Snapshots kept per company by the nightly timer.
PALLET_BACKUPS=30

NODE_ENV=production
