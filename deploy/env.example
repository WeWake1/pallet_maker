# /etc/pallet-spec/env — read by the systemd units. Copy, edit, chmod 640 root:pallet.

# Everything the server keeps: library/, its backups/, and from phase 2 the
# companies. Put it on the data disk, not the OS disk.
PALLET_DATA_ROOT=/var/lib/pallet-spec

# The date stamped on a design when it is saved.
PALLET_TIMEZONE=Asia/Kolkata

# The Chromium that prints the sheets. Debian's package puts it here.
PALLET_BROWSER=/usr/bin/chromium

# Loopback only: Caddy is the only thing that talks to it.
HOST=127.0.0.1
PORT=5179

# Snapshots kept by the startup backup. The nightly timer keeps its own 30.
PALLET_BACKUPS=20

NODE_ENV=production
