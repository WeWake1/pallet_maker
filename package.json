{
  "name": "pallet-spec-generator",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Pallet specification sheet generator",
  "scripts": {
    "layout": "tsx src/cli/layout.ts",
    "views": "tsx src/cli/views.ts",
    "sheet": "tsx src/cli/sheet.ts",
    "dxf": "tsx src/cli/dxf.ts",
    "backup": "tsx src/cli/backup.ts",
    "guide": "tsx src/cli/guide.ts",
    "brand": "tsx src/brand/build.ts",
    "dev": "vite",
    "build": "vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/main.mjs --log-level=warning && esbuild src/cli/backup.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/backup.mjs --log-level=warning && esbuild src/cli/tenant.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/tenant.mjs --log-level=warning",
    "preview": "vite preview",
    "serve": "tsx src/server/main.ts --local",
    "serve:watch": "tsx watch src/server/main.ts --local",
    "start": "npm run build && npm run serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tenant": "tsx src/cli/tenant.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^10.0.11",
    "puppeteer-core": "^25.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "author": "Ambica Patterns (India) Pvt. Ltd.",
  "repository": {
    "type": "git",
    "url": "https://github.com/WeWake1/pallet_maker.git"
  }
}
