{
  "name": "pallet-spec-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pallet specification sheet generator - geometry engine",
  "scripts": {
    "layout": "tsx src/cli/layout.ts",
    "views": "tsx src/cli/views.ts",
    "sheet": "tsx src/cli/sheet.ts",
    "dxf": "tsx src/cli/dxf.ts",
    "costing": "tsx src/cli/costing.ts",
    "convert": "tsx src/cli/convert.ts",
    "guide": "tsx src/cli/guide.ts",
    "brand": "tsx src/brand/build.ts",
    "dev": "vite",
    "build": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist/electron/main.cjs --external:electron --packages=external --alias:puppeteer-core=./electron/no-puppeteer.ts --log-level=warning",
    "app": "npm run build && npm run build:electron && electron .",
    "preview": "vite preview",
    "serve": "tsx src/server/main.ts",
    "serve:watch": "tsx watch src/server/main.ts",
    "start": "npm run build && npm run serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "compare:pdf": "esbuild electron/compare.ts --bundle --platform=node --format=cjs --outfile=dist/electron/compare.cjs --external:electron --packages=external --log-level=warning && electron dist/electron/compare.cjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "^13.0.1",
    "electron": "^43.4.0",
    "puppeteer-core": "^25.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "main": "dist/electron/main.cjs"
}
