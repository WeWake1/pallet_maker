{
  "name": "pallet-spec-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pallet specification sheet generator - geometry engine",
  "scripts": {
    "layout": "tsx src/cli/layout.ts",
    "views": "tsx src/cli/views.ts",
    "sheet": "tsx src/cli/sheet.ts",
    "dxf": "tsx src/cli/dxf.ts",
    "costing": "tsx src/cli/costing.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "tsx src/server/main.ts",
    "start": "npm run build && npm run serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "express": "^5.2.1",
    "puppeteer-core": "^25.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
